# KrishiSayog Environment Configuration
# Copy this file to .env and fill in your values

# OpenWeatherMap API Key (free: openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# IoT Mode: "simulator" (default) or "real" (ESP32 connected)
VITE_IOT_MODE=simulator

# ESP32 IP Address (only needed when IOT_MODE=real)
VITE_ESP32_URL=http://192.168.1.100

# Farm Location (latitude, longitude)
VITE_LOCATION_LAT=19.9975
VITE_LOCATION_LON=73.7898

# Google Gemini API Key (free: aistudio.google.com/apikey)
# Get your key at: https://aistudio.google.com/apikey
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Authentication Config
# Get these values from your Firebase Console Project Settings
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
